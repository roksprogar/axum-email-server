{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                m.id,\n                COALESCE(m.conversation_id, m.id) AS \"conversation_id!\",\n                (a.local_part || '@' || d.domain) AS \"address!\",\n                m.message_id,\n                m.in_reply_to,\n                m.references_header,\n                m.envelope_from,\n                m.envelope_to,\n                m.from_display,\n                m.subject,\n                m.body_text,\n                m.body_html,\n                m.spf_result,\n                m.dkim_result,\n                m.received_at,\n                m.read_at,\n                m.replied_at\n            FROM mail_messages m\n            JOIN mail_addresses a ON a.id = m.address_id\n            JOIN mail_domains d ON d.id = a.domain_id\n            WHERE m.id = $1\n            ",
